# vscode files
.vscode/**
.vscode-test/**

# test build output
out/**

# dist/ ships in the package on purpose (it holds the compiled main entry),
# including its .js.map files: the extension installs source-map-support at
# runtime and logger.ts prefixes each log line with the caller's remapped
# src/*.ts position, so the maps must be present. Do not add dist/*.map or
# *.map exclusions here. See esbuild.js for the full rationale.

# source code
src/**
scripts/**

# github files
.github/**

.eslintrc.json
.prettierignore
.gitignore
pnpm-lock.yaml
pnpm-workspace.yaml
esbuild.js
**/tsconfig.json
**/*.ts
docs
renovate.json
vscode-monitor-pro.code-workspace
assets/*.png
!assets/icon.png
go-backend/
!go-backend/bin/*

# other md files
*.md
!README.md
!CHANGELOG.md
